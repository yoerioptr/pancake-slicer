# ---------------------------------------------------------------------------
# PancakeSlicer on TrueNAS SCALE - deployment configuration
#
# Copy this file to .env, then adjust the values for your system:
#   cp .env.example .env
#
# Never commit .env. The rendered build/compose.yaml contains these values.
# ---------------------------------------------------------------------------

# Upstream image and pinned release. Bump PANCAKE_VERSION deliberately after
# reviewing the upstream release notes.
PANCAKE_IMAGE=zimengxiong/pancakeslicer
PANCAKE_VERSION=0.5.5

# Host port exposed on the TrueNAS IP: http://<TRUENAS_IP>:6868
PANCAKE_PORT=6868

# Persistent application state (projects, profiles, printers, preferences,
# finished jobs) and the disposable slicing stage cache.
#
# The image runs as UID/GID 65532. Both directories must be writable by it.
# On TrueNAS:
#   mkdir -p /mnt/Apps/PancakeSlicer/data /mnt/Apps/PancakeSlicer/cache
#   chown -R 65532:65532 /mnt/Apps/PancakeSlicer
PANCAKE_DATA_PATH=/mnt/Apps/PancakeSlicer/data
PANCAKE_CACHE_PATH=/mnt/Apps/PancakeSlicer/cache

# Runtime tuning.
# Number of slices that may run at once; additional jobs queue.
PANCAKE_MAX_JOBS=2
# Cap for the disposable engine stage cache, in MB.
PANCAKE_STAGE_CACHE_MAX_MB=1024
# Container memory limit. Slicing is CPU and memory intensive.
PANCAKE_MEMORY_LIMIT=8g

# Where the service may connect to printers:
#   lan                              private IPv4/IPv6 ranges
#   lan,192.168.1.50,printer.local   explicit addresses/hostnames
#   off                              disable printer connections
PANCAKE_PRINTER_NETWORK=lan

# Optional mutation bearer token. Strongly recommended if anyone you do not
# trust can reach the UI. Leave empty to disable. Never commit a real value.
# `scripts/init-env.sh` generates one automatically.
# Generate one manually with: openssl rand -hex 32
PANCAKE_BEARER_TOKEN=

# Only needed behind a reverse proxy. Set this to the proxy's source CIDR,
# for example 172.16.0.0/12 for the default Docker bridge range.
PANCAKE_TRUSTED_PROXIES=

# Optional GitHub "owner/repo" used for an update notice. Leave empty to
# disable the notice.
PANCAKE_RELEASE_FEED=

# Timezone inside the container.
TZ=Etc/UTC
